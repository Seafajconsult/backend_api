# JWT Configuration
JWT_SECRET=""
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET=""
JWT_REFRESH_EXPIRES_IN="7d"

# Cookie Configuration
COOKIE_SECRET="'483eedfdede2d0c3420f9a4ec5a8b8c22acb49af77c72d311e19874c67fe6c9c8d898bab2354c538f559b0429fa01797363c8e757c8e35e26b9ba714c1c455869fca4b33dd750888e3c778055f9c309799a22b9b7fccdd6b388ef316619113aaaae177353229821771dbebca98376aebd4d56f228df3c84b146227ca94b1dd60'"

# Brevo Email Service
BREVO_API_KEY="your-brevo-api-key"
BREVO_SENDER_EMAIL="noreply@sea-faj.com"
BREVO_SENDER_NAME="SEA-FAJ Consult"

# Paystack Payment
PAYSTACK_SECRET_KEY="sk_test_your_paystack_secret_key"
PAYSTACK_PUBLIC_KEY="pk_test_your_paystack_public_key"
PAYSTACK_WEBHOOK_SECRET="your_paystack_webhook_secret"

# Cloudinary File Storage
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# Application Configuration
NODE_ENV="development"
PORT=3000
CORS_ORIGIN="http://localhost:3000,http://localhost:3001"

# Frontend URLs
FRONTEND_URL="http://localhost:3001"
STUDENT_PORTAL_URL="http://localhost:3001/student"
EMPLOYER_PORTAL_URL="http://localhost:3001/employer"
ADMIN_PORTAL_URL="http://localhost:3001/admin"

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=10

# Redis (Optional - for caching)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# Email Templates
EMAIL_VERIFICATION_TEMPLATE_ID=1
PASSWORD_RESET_TEMPLATE_ID=2
WELCOME_TEMPLATE_ID=3
APPLICATION_STATUS_TEMPLATE_ID=4
PAYMENT_CONFIRMATION_TEMPLATE_ID=5

# File Upload Limits
MAX_FILE_SIZE=10485760  # 10MB in bytes
ALLOWED_FILE_TYPES="jpg,jpeg,png,pdf,doc,docx"

# OTP Configuration
OTP_EXPIRY_MINUTES=10
OTP_LENGTH=6

# Super Admin Default Credentials (Change in production)
SUPER_ADMIN_EMAIL="admin@sea-faj.com"
SUPER_ADMIN_PASSWORD="SuperAdmin123!"
SUPER_ADMIN_FIRST_NAME="Super"
SUPER_ADMIN_LAST_NAME="Admin"
