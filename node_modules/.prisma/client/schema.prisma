generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  EMPLOYER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum ApplicationStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  REJECTED
}

enum VisaStatus {
  NOT_STARTED
  DOCUMENTS_SUBMITTED
  APPOINTMENT_SCHEDULED
  INTERVIEW_COMPLETED
  VISA_GRANTED
  VISA_REJECTED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  password  String
  role      UserRole
  status    UserStatus @default(PENDING)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // Profile relations based on role
  student    Student?
  employer   Employer?
  admin      Admin?
  superAdmin SuperAdmin?

  // Common relations
  chatMessages  ChatMessage[]
  notifications Notification[]

  @@map("users")
}

model Student {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId    String   @unique
  firstName        String
  lastName         String
  dateOfBirth      DateTime
  nationality      String
  phone            String?
  address          String?
  currentEducation String?
  referralCode     String?  @unique
  referredBy       String?

  // Relations
  documents        Document[]
  applications     Application[]
  visaApplications VisaApplication[]
  payments         Payment[]
  testimonial      Testimonial?
  universityOffers UniversityOffer[]

  @@map("students")
}

model Employer {
  id                 String  @id @default(uuid())
  userId             String  @unique
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName        String
  registrationNumber String  @unique
  companySize        Int?
  industry           String?
  website            String?
  address            String
  phone              String
  verificationDoc    String? // URL to CAC/UK document

  // Relations
  recruitmentRequests RecruitmentRequest[]
  jobPostings         JobPosting[]
  payments            Payment[]

  @@map("employers")
}

model Admin {
  id           String @id @default(uuid())
  userId       String @unique
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName    String
  lastName     String
  department   String
  assignedRole String // e.g., "student_management", "employer_management"

  @@map("admins")
}

model SuperAdmin {
  id        String @id @default(uuid())
  userId    String @unique
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName String
  lastName  String

  @@map("super_admins")
}

model Application {
  id         String            @id @default(uuid())
  studentId  String
  student    Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status     ApplicationStatus @default(PENDING)
  program    String
  university String
  intake     DateTime
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  // Relations
  documents Document[]

  @@map("applications")
}

model VisaApplication {
  id              String     @id @default(uuid())
  studentId       String
  student         Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status          VisaStatus @default(NOT_STARTED)
  country         String
  appointmentDate DateTime?
  documents       Document[]
  notes           String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@map("visa_applications")
}

model Document {
  id                String           @id @default(uuid())
  name              String
  type              String // e.g., "passport", "transcript", "offer_letter"
  url               String // Cloudinary URL
  studentId         String
  student           Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  applicationId     String?
  application       Application?     @relation(fields: [applicationId], references: [id])
  visaApplicationId String?
  visaApplication   VisaApplication? @relation(fields: [visaApplicationId], references: [id])
  uploadedAt        DateTime         @default(now())

  @@map("documents")
}

model UniversityOffer {
  id          String    @id @default(uuid())
  studentId   String
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  university  String
  program     String
  offerLetter String // URL to offer letter
  status      String // "pending", "accepted", "rejected"
  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  @@map("university_offers")
}

model RecruitmentRequest {
  id           String   @id @default(uuid())
  employerId   String
  employer     Employer @relation(fields: [employerId], references: [id], onDelete: Cascade)
  type         String // "PRN", "One-Time", "Outsourcing"
  jobTitle     String
  description  String
  requirements String[]
  budget       Float
  deadline     DateTime
  status       String // "pending", "in_progress", "completed"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("recruitment_requests")
}

model JobPosting {
  id           String   @id @default(uuid())
  employerId   String
  employer     Employer @relation(fields: [employerId], references: [id], onDelete: Cascade)
  title        String
  description  String
  requirements String[]
  location     String
  type         String // "full-time", "part-time", "contract"
  salary       Float?
  createdAt    DateTime @default(now())
  deadline     DateTime
  status       String // "open", "closed"

  @@map("job_postings")
}

model Payment {
  id          String        @id @default(uuid())
  amount      Float
  currency    String        @default("NGN")
  status      PaymentStatus @default(PENDING)
  type        String // "service_fee", "recruitment_fee"
  reference   String        @unique
  studentId   String?
  student     Student?      @relation(fields: [studentId], references: [id])
  employerId  String?
  employer    Employer?     @relation(fields: [employerId], references: [id])
  metadata    Json?
  paymentDate DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("payments")
}

model ChatMessage {
  id        String   @id @default(uuid())
  content   String
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  roomId    String
  createdAt DateTime @default(now())

  @@map("chat_messages")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String // "info", "success", "warning", "error"
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("notifications")
}

model Testimonial {
  id         String   @id @default(uuid())
  studentId  String   @unique
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  content    String
  rating     Int
  videoUrl   String? // Cloudinary URL
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("testimonials")
}
